# =====================================================================
# LinkedIn Automation Studio - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# WARNING: NEVER commit your actual '.env' file to version control!
# =====================================================================

# ---------------------------------------------------------------------
# Discord Delivery & Interactive Bot (Required for live assistant)
# ---------------------------------------------------------------------
# Discord Bot Token from Developer Portal (with Message Content Intent enabled)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Channel Webhook URL (for autonomous push deliveries)
DISCORD_WEBHOOK_URL=

# Polling interval in seconds for background REST message poller
DISCORD_POLL_INTERVAL_SECONDS=1.5

# Maximum LRU cache size for message deduplication
MESSAGE_CACHE_MAX_SIZE=500

# ---------------------------------------------------------------------
# Google Gemini API (Required for Multi-Agent Strategist & Critic)
# ---------------------------------------------------------------------
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# LinkedIn API (Optional: used for direct autonomous publishing)
# ---------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:your_author_urn_here
